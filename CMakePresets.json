{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TH03_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "msvc-x64",
      "inherits": "base",
      "displayName": "MSVC x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/msvc-x64"
    },
    {
      "name": "gcc",
      "inherits": "base",
      "displayName": "MinGW GCC",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/out/build/gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-x64-sdl",
      "inherits": "msvc-x64",
      "displayName": "MSVC x64 with SDL 3",
      "binaryDir": "${sourceDir}/out/build/msvc-x64-sdl",
      "cacheVariables": {
        "TH03_ENABLE_SDL": "ON",
        "TH03_SDL3_PROVIDER": "source",
        "TH03_SDL3_SOURCE_DIR": "${sourceDir}/out/deps/SDL3-3.4.10"
      }
    },
    {
      "name": "gcc-sdl",
      "inherits": "gcc",
      "displayName": "MinGW GCC with SDL 3",
      "binaryDir": "${sourceDir}/out/build/gcc-sdl",
      "cacheVariables": {
        "TH03_ENABLE_SDL": "ON",
        "TH03_SDL3_PROVIDER": "source",
        "TH03_SDL3_SOURCE_DIR": "${sourceDir}/out/deps/SDL3-3.4.10"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-x64",
      "configurePreset": "msvc-x64",
      "configuration": "Debug"
    },
    {
      "name": "gcc",
      "configurePreset": "gcc"
    },
    {
      "name": "msvc-x64-sdl",
      "configurePreset": "msvc-x64-sdl",
      "configuration": "Debug"
    },
    {
      "name": "gcc-sdl",
      "configurePreset": "gcc-sdl"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-x64",
      "configurePreset": "msvc-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc",
      "configurePreset": "gcc",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc-x64-sdl",
      "configurePreset": "msvc-x64-sdl",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc-sdl",
      "configurePreset": "gcc-sdl",
      "output": { "outputOnFailure": true }
    }
  ]
}
