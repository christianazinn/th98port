{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/msvc-x64"
    },
    {
      "name": "gcc",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/out/build/gcc",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-x64", "configurePreset": "msvc-x64", "configuration": "Debug" },
    { "name": "gcc", "configurePreset": "gcc" }
  ],
  "testPresets": [
    { "name": "msvc-x64", "configurePreset": "msvc-x64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "gcc", "configurePreset": "gcc", "output": { "outputOnFailure": true } }
  ]
}
